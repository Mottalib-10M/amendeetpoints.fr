---
/** Page embarquable (iframe) : le calculateur d'excès de vitesse sans navigation. noindex, hors sitemap (astro.config). */
import '../../styles/global.css';
import ExcesTool from '../../components/am/ExcesTool';
import { SITE_URL } from '../../data/site-config';
import { P } from '../../lib/engine/params';
import { displayDate } from '../../lib/format';
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Amende pour excès de vitesse : calcul – widget</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`${SITE_URL}/fr/`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <ExcesTool client:load lang="fr" id="embed" />
    <p class="mt-2 text-center text-xs text-navy-600"><a href={`${SITE_URL}/fr/`} target="_blank" rel="noopener" class="underline">Amende et Points</a> · Code de la route, textes relus le {displayDate(P.retrieved_at, 'fr-FR')}</p>
  </body>
</html>
